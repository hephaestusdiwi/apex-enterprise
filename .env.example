DATABASE_URL=postgresql://apex_enterprise:devpass@127.0.0.1:5433/apex_enterprise
PAYLOAD_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SITE_URL=http://localhost:3000
# Job terjadwal (kedaluwarsa hold, reminder H-1) berjalan di dalam app. Set false pada instance tambahan.
JOBS_AUTORUN=true

# Produksi wajib mengisi SMTP_HOST, SMTP_USER, SMTP_PASS, dan SMTP_FROM_ADDRESS.
# Gunakan alamat pengirim dari domain sendiri dengan SPF/DKIM yang sudah diset agar email tidak masuk spam.
# Kosongkan SMTP_HOST hanya untuk development (email akan dicetak ke console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=APEX
